{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bodygroovn v6.0.0 After Effects validation record",
  "type": "object",
  "required": ["schemaVersion", "os", "ae", "candidate", "validation", "checks", "human", "harness"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "os": { "enum": ["windows", "macos"] },
    "ae": {
      "type": "object",
      "required": ["major", "version", "build"],
      "properties": {
        "major": { "enum": ["2025", "2026"] },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["runId", "runAttempt", "zxpSha256"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[0-9]+$" },
        "runAttempt": { "type": "string", "pattern": "^[0-9]+$" },
        "zxpSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["runId", "runAttempt"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[0-9]+$" },
        "runAttempt": { "type": "string", "pattern": "^[0-9]+$" }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": [
        "installRemove",
        "menuPanel",
        "standard",
        "segmented",
        "demo",
        "standalone",
        "imagesFontsAudioExpressionsAnnotations",
        "essentialPropertiesGradientTextSlots",
        "pngPalettesAndPreservation",
        "iosAndroidReports",
        "localPreviewAndGzipPlayer",
        "serverRestartTokenRotation",
        "noUiFreeze",
        "canonicalDiffApproved"
      ],
      "properties": {
        "installRemove": { "const": true },
        "menuPanel": { "const": true },
        "standard": { "const": true },
        "segmented": { "const": true },
        "demo": { "const": true },
        "standalone": { "const": true },
        "imagesFontsAudioExpressionsAnnotations": { "const": true },
        "essentialPropertiesGradientTextSlots": { "const": true },
        "pngPalettesAndPreservation": { "const": true },
        "iosAndroidReports": { "const": true },
        "localPreviewAndGzipPlayer": { "const": true },
        "serverRestartTokenRotation": { "const": true },
        "noUiFreeze": { "const": true },
        "canonicalDiffApproved": { "const": true }
      },
      "additionalProperties": false
    },
    "human": {
      "type": "object",
      "required": ["reviewer", "approved"],
      "properties": { "reviewer": { "type": "string", "minLength": 1 }, "approved": { "const": true } },
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "required": ["logArtifact"],
      "properties": { "logArtifact": { "type": "string", "pattern": "^ae-validation-(windows|macos)-(2025|2026)\\.log$" } },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
