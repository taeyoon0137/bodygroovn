{
  "name": "@taeyoon0137/bodygroovn",
  "version": "5.12.0",
  "private": true,
  "type": "module",
  "homepage": ".",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "build": "node scripts/build-extension.mjs",
    "build:panel": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "node --test test/server/localServer.test.cjs test/server/pngValidation.test.cjs",
    "test:node17": "node test/server/node17Smoke.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "check:csinterface": "node scripts/check-csinterface.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:payload": "node scripts/check-payload.mjs build/bodygroovn",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:removed": "node scripts/check-removed-features.mjs",
    "check:toolchain": "node scripts/ci/check-toolchain.mjs",
    "verify": "yarn check:toolchain && yarn version:check && yarn check:provenance && yarn check:generated && yarn check:removed && yarn lint && yarn typecheck && yarn test && yarn test:server && yarn build"
  },
  "dependencies": {
    "aphrodite": "2.4.0",
    "deepmerge": "4.3.1",
    "escodegen": "2.1.0",
    "esprima": "4.0.1",
    "file-type": "16.5.4",
    "lz-string": "1.5.0",
    "pako": "1.0.11",
    "prop-types": "15.8.1",
    "react": "19.2.8",
    "react-colorful": "5.8.0",
    "react-dom": "19.2.8",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "redux-saga": "1.5.1",
    "reselect": "5.3.0",
    "upng-js": "2.1.0",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-config-taeyoon": "0.2.2",
    "eslint-plugin-react": "7.37.5",
    "happy-dom": "20.11.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
